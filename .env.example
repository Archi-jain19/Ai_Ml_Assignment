# ==============================================================================
# FacetLens Environment Configuration (.env.example)
# ==============================================================================

# LLM Inference (Optional for live LLM scoring; deterministic offline heuristic engine runs if unset)
# Obtain a free API key from https://console.groq.com/keys
GROQ_API_KEY=

# Scoring Model (Strictly open-weight <=16B; defaults to Llama 3.1 8B Instruct)
SCORING_MODEL=llama-3.1-8b-instant

# Candidate Retrieval Configuration (Top-K candidates retrieved per conversation)
TOP_K=20

# Micro-Batch Size for Structured LLM Scoring
BATCH_SIZE=5

# Service Ports (for Docker Compose)
BACKEND_PORT=8000
FRONTEND_PORT=3000
